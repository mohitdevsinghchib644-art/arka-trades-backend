# Supabase credentials (from Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Production Frontend URL on Cloudflare Pages (e.g. https://arka-trades.pages.dev)
FRONTEND_URL=https://arka-trades.pages.dev

# Server Port (Render sets this automatically via $PORT)
PORT=8000
